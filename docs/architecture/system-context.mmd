flowchart LR
    user([Data steward or analyst])
    fe[Datara web application<br/>Next.js 16 and React 19<br/>hosted on Vercel]
    api[Datara API<br/>FastAPI<br/>hosted on Render]
    db[(PostgreSQL<br/>Neon, ap-southeast-1)]
    engine[Quality engine<br/>pandas]
